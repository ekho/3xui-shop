{
 admin off
 auto_https off
 persist_config off
}
(headers) {
 header {
  defer
  Referrer-Policy no-referrer
  X-Content-Type-Options nosniff
  Cache-Control no-store
 }
}
https://{$CABINET_HOST}:8443 {
 tls /run/secrets/public_cert /run/secrets/public_key
 import headers
 @browserSecurity not path /mini-app /mini-app/*
 header @browserSecurity Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-PgqzSxMpLRBzUhg2SooHKWZ2oAc0yWVxeNMrpG5YqoM='; style-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self' https://yoomoney.ru; frame-ancestors 'none'" {
  defer
 }
 @maintenance {
  expression `{env.CABINET_MAINTENANCE} == "true"`
  not path /internal/* /webhooks/yoomoney /webhooks/yookassa /webhooks/cryptomus /webhooks/heleket /yoomoney /yookassa /cryptomus /heleket
 }
 handle @maintenance {
  respond "Service maintenance" 503
 }
 handle /internal/* {
  respond 404
 }
 handle /api/* {
  reverse_proxy backend:8080
 }
 @yoomoney path /webhooks/yoomoney /yoomoney
 handle @yoomoney {
  reverse_proxy backend:8080
 }
 @yookassa path /webhooks/yookassa /yookassa
 handle @yookassa {
  reverse_proxy backend:8080
 }
 @cryptomus path /webhooks/cryptomus /cryptomus
 handle @cryptomus {
  reverse_proxy backend:8080
 }
 @heleket path /webhooks/heleket /heleket
 handle @heleket {
  reverse_proxy backend:8080
 }
 handle /healthz {
  reverse_proxy backend:8080
 }
 handle /readyz {
  reverse_proxy backend:8080
 }
 handle /config.json {
  root * /run/web-public
  file_server
 }
 @mini path /mini-app /mini-app/*
 handle @mini {
  header Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors https://web.telegram.org"
  root * /srv
  try_files /mini-app.html
  file_server
 }
 handle {
  root * /srv
  try_files {path} /index.html
  file_server
 }
}
