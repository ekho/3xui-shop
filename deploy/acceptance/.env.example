# Public values and absolute secret-file paths only. Use a dedicated test environment.
PRODUCT_NAME=Example service
CABINET_HOST=cabinet.example.test
CABINET_ORIGIN=https://cabinet.example.test:58443
TERMS_VERSION=1
PRIVACY_VERSION=1
TERMS_URL=https://policies.example.test/terms
PRIVACY_URL=https://policies.example.test/privacy
SUPPORT_URL=mailto:support@example.test
BOT_OPERATOR_IDS=101
SMTP_ADDRESS=smtp.example.test:465
SMTP_USER=test-account
SMTP_FROM=test-account@example.test
PANEL_URL=https://panel.example.test
SUBSCRIPTION_BASE_URL=https://subscriptions.example.test/sub/
ACCESS_RESET_TIMEZONE=UTC
TRIAL_ENABLED=false
PANEL_DUPLICATE_GUARD_VERIFIED=false
TRIAL_PERIOD=3
TRIAL_TRAFFIC_GB=15
BONUS_DEVICES_COUNT=1
SHOP_REFERRER_REWARD_ENABLED=true
SHOP_REFERRED_REWARD_TYPE=days
SHOP_REFERRER_LEVEL_ONE_PERIOD=10
SHOP_REFERRER_LEVEL_TWO_PERIOD=3
AUDIT_RETENTION_DAYS=365
AUDIT_RETENTION_TIMEZONE=UTC
BOT_TIMEZONE=UTC
# Native modules are opt-in; never run the legacy executor for the same operation.
TELEGRAM_ENABLED=false
SUPPORT_TELEGRAM_ENABLED=false
AUDIT_MIRROR_ENABLED=false
SHOP_PAYMENT_STARS_ENABLED=false
# Set these paths only when their channel is enabled.
BOT_TOKEN_FILE=
SUPPORT_BOT_TOKEN_FILE=
SUPPORT_GROUP_ID=
OPERATIONS_EMAIL_FILE=
# External payments retain credentials on sales disable; select their existing overlay.
# See the deployment inventory linked in DEPLOYMENT.md for all settings.
APP_RUNTIME_UID=10001
APP_RUNTIME_GID=10001
APP_NETWORK_SUBNET=172.31.98.0/28
APP_GATEWAY_IP=172.31.98.14
PG_USER=cabinet
BASE_DATABASE=cabinet
PG_PASSWORD_FILE=/secure/cabinet/pg-password
DATABASE_URL_FILE=/secure/cabinet/database-url
REDIS_URL_FILE=/secure/cabinet/redis-url
MAIL_KEY_FILE=/secure/cabinet/mail-key
CODE_KEY_FILE=/secure/cabinet/code-key
SMTP_PASSWORD_FILE=/secure/cabinet/smtp-password
SMTP_CA_FILE=/secure/cabinet/smtp-ca.pem
PANEL_TOKEN_FILE=/secure/cabinet/panel-token
PANEL_CA_FILE=/secure/cabinet/panel-ca.pem
PUBLIC_CERT_FILE=/secure/cabinet/cabinet-cert.pem
PUBLIC_KEY_FILE=/secure/cabinet/cabinet-key.pem
