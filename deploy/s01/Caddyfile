{
 admin off
 auto_https off
 persist_config off
}
(headers) {
 header {
  Referrer-Policy no-referrer
  X-Content-Type-Options nosniff
  Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-PgqzSxMpLRBzUhg2SooHKWZ2oAc0yWVxeNMrpG5YqoM='; style-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
  Cache-Control no-store
 }
}
https://{$CABINET_HOST}:8443 {
 tls /run/secrets/public_cert /run/secrets/public_key
 import headers
 @maintenance expression `{env.CABINET_MAINTENANCE} == "true"`
 handle @maintenance {
  respond "Service maintenance" 503
 }
 handle /internal/* {
  respond 404
 }
 handle /api/* {
  reverse_proxy backend:8080
 }
 handle /healthz {
  reverse_proxy backend:8080
 }
 handle {
  root * /srv
  try_files {path} /index.html
  file_server
 }
}
https://gateway:9443 {
 tls /run/secrets/adapter_cert /run/secrets/adapter_key
 import headers
 handle /internal/* {
  reverse_proxy backend:8080
 }
 handle {
  respond 404
 }
}
