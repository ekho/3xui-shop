FROM python:3.13-slim@sha256:7c61056e61ac89e852de05f3dc6fa51a6dd2181797bceed46aa725dd7cb2cd3b
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 POETRY_VIRTUALENVS_CREATE=false
WORKDIR /workspace
COPY pyproject.toml poetry.lock ./
RUN pip install --no-cache-dir poetry==2.5.1 && poetry install --only main --no-root --no-interaction
COPY app ./app
COPY deploy/s01/bot_adapter.py ./bot_adapter.py
USER 10001:10001
ENTRYPOINT ["python", "bot_adapter.py"]
